{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Server (node trực tiếp)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/api/src/server.js",
      "runtimeArgs": ["--env-file=${workspaceFolder}/api/.env"],
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}